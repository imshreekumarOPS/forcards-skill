<!doctype html>
<html><head><meta charset="utf-8">
<style>
@font-face{font-family:"{{ t.type.family }}";src:url("{{ font_url }}") format("woff2");font-weight:100 900;unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
@font-face{font-family:"{{ t.type.family }}";src:url("{{ font_ext_url }}") format("woff2");font-weight:100 900;unicode-range:U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF}
*{box-sizing:border-box;margin:0;padding:0}
html,body{background:{{ t.colors.bg }}}
body{
  width:{{ W }}px;height:{{ H }}px;overflow:hidden;
  padding:0 {{ t.space.page_x }}px;
  display:flex;flex-direction:column;justify-content:center;
  font-family:"{{ t.type.family }}",system-ui,sans-serif;
  -webkit-font-smoothing:antialiased;text-rendering:geometricPrecision;
  font-feature-settings:"cv11" 0;
}
h1{
  font-size:{{ t.type.title_size }}px;font-weight:{{ t.type.title_weight }};
  letter-spacing:{{ t.type.title_tracking }}em;line-height:normal;color:{{ t.colors.title }};
  margin-bottom:{{ t.space.title_to_cards }}px;white-space:nowrap;
}
h1 mark{
  background:linear-gradient({{ t.colors.highlight }},{{ t.colors.highlight }}) no-repeat 0 100%/100% {{ t.space.highlight_h }}px;
  color:inherit;padding:0 {{ t.space.highlight_pad_x }}px;
}
.cards{display:flex;flex-direction:column;gap:{{ t.space.card_gap }}px}
.card{
  border:{{ t.space.border_w }}px solid {{ t.colors.border }};border-radius:{{ t.space.card_radius }}px;
  padding:{{ t.space.card_pad_top }}px {{ t.space.card_pad_x }}px {{ t.space.card_pad_bottom }}px;
  background:{{ t.colors.bg }};
}
h2{
  font-size:{{ t.type.heading_size }}px;font-weight:{{ t.type.heading_weight }};
  letter-spacing:{{ t.type.heading_tracking }}em;line-height:1.2;color:{{ t.colors.heading }};
  margin-bottom:{{ t.space.heading_to_body }}px;
}
ul{list-style:none}
li{
  position:relative;padding-left:{{ t.space.bullet_text_x }}px;
  font-size:{{ t.type.body_size }}px;font-weight:{{ t.type.body_weight }};letter-spacing:{{ t.type.body_tracking }}em;
  line-height:{{ t.type.body_line_height }}px;color:{{ t.colors.body }};
}
li + li{margin-top:{{ t.space.bullet_gap }}px}
li::before{
  content:"";position:absolute;left:{{ t.space.bullet_indent }}px;
  top:{{ ((t.type.body_line_height - t.space.dot_size) / 2) | round(1) }}px;
  width:{{ t.space.dot_size }}px;height:{{ t.space.dot_size }}px;border-radius:50%;background:{{ t.colors.accent }};
}
</style></head>
<body>
{% if title_html %}<h1>{{ title_html|safe }}</h1>{% endif %}
<div class="cards">
{% for c in cards %}
  <section class="card"><h2>{{ c.heading }}</h2><ul>{% for b in c.bullets %}<li>{{ b }}</li>{% endfor %}</ul></section>
{% endfor %}
</div>
</body></html>
